<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap3">

  <!--
    上架微软商店前确认以下字段(与商店后台产品标识一致):
    - Name:      商店后台保留的唯一包名(当前: AceShell)
    - Publisher: 商店后台"产品标识"中分配的 Publisher ID(CN=...)
    - DisplayName / PublisherDisplayName / Description
    - Version:   由打包脚本按标签版本自动替换,无需手工改
  -->
  <Identity
    Name="AceShell"
    Publisher="CN=5A3FBAB9-DA34-4BF8-A23D-BBE10243FF61"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AceShell</DisplayName>
    <PublisherDisplayName>dingtongbin</PublisherDisplayName>
    <Description>跨平台网络终端管理工具</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="AceShell" Executable="AceShell.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AceShell"
        Description="跨平台网络终端管理工具"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="AceShell.exe" />
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
